# Pet Freedom — copy to .env (gitignored) and fill in. NEVER commit the real .env.

# ── WordPress (required) ──
# WP_URL: your site root, no trailing slash. WP_USERNAME: a user with publish rights.
# WP_APP_PASSWORD: a WordPress Application Password (Users → Profile → Application Passwords).
# Paste it WITH or without the spaces WordPress shows — the spaces are cosmetic and get stripped.
WP_URL=https://example.com
WP_USERNAME=your-wp-user
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# ── Mailbox (OPTIONAL — only needed if you enable the agency-inquiry module) ──
# Use a real, authenticated mailbox on your domain, and set up SPF/DKIM/DMARC (see docs/EMAIL-DELIVERABILITY.md)
# or strict receivers will bounce your inquiries. SMTP for sending, IMAP for reading replies.
SITE_MAIL_USER=you@example.com
SITE_MAIL_PASS=your-mailbox-password
SITE_SMTP_HOST=mail.example.com
SITE_SMTP_PORT=465
SITE_IMAP_HOST=mail.example.com
SITE_IMAP_PORT=993
